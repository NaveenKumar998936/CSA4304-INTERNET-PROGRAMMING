<!-- APPOINTMENT HISTORY -->
<section id="appointmentsPage" class="panel hidden">
    <h2>My Appointments and History</h2>
    <div id="appointmentList"></div>
</section>

<!-- PROFILE -->
<section id="profilePage" class="panel hidden">
    <h2>Update Personal Details</h2>
    <div class="grid">
        <div class="field"><label>Name</label><input id="profileName"></div>
        <div class="field"><label>Phone</label><input id="profilePhone"></div>
        <div class="field"><label>Location</label><input id="profileLocation"></div>
