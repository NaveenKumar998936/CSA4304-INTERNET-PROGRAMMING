    <h3>Patient Check-in Details</h3>
    <div class="grid">
        <div class="field"><label>Patient Name</label><input id="patientName"></div>
        <div class="field"><label>Age</label><input id="patientAge" type="number" min="1" max="120"></div>
        <div class="field"><label>Phone</label><input id="patientPhone"></div>
        <div class="field"><label>Reason for Visit</label><input id="visitReason" placeholder="Brief reason"></div>
    </div>

    <div class="actions">
        <button class="success" onclick="bookAppointment()">Confirm Appointment</button>
