        </div>
    </div>
    <div class="actions">
        <button onclick="searchHospitals()">Search</button>
        <button class="secondary" onclick="showAllHospitals()">Show All</button>
    </div>
    <div id="hospitalResults"></div>
    <p class="note">Hospital and doctor entries are sample data for this demonstration.</p>
</section>

<!-- APPOINTMENT BOOKING -->
<section id="bookingPage" class="panel hidden">
    <h2>Book Appointment</h2>
    <div id="bookingHospitalInfo"></div>

    <div class="grid">
        <div class="field">
            <label>Doctor</label>
            <select id="doctorSelect" onchange="updateDoctorDetails()"></select>
        </div>
        <div class="field">
            <label>Appointment Date</label>
            <input id="appointmentDate" type="date" onchange="updateSlots()">
        </div>
        <div class="field">
            <label>Available Time</label>
