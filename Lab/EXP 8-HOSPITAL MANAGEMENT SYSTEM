function addDoctor() {
    const hospitals = read(KEYS.hospitals);
    const hospital = hospitals.find(h => h.owner === currentUser.email);
    if (!hospital) return alert("Hospital record not found.");

    const name = document.getElementById("newDoctorName").value.trim();
