}

function submitReview() {
    if (currentUser.role !== "patient") {
        alert("Only patients can submit reviews.");
        return;
    }

    const text = document.getElementById("reviewText").value.trim();
    if (!text) return alert("Write a review first.");

    const hospitalId = document.getElementById("reviewHospital").value;
    const doctorId = document.getElementById("reviewDoctor").value;
    const hospital = read(KEYS.hospitals).find(h => h.id === hospitalId);
    const doctor = hospital?.doctors.find(d => d.id === doctorId);

    const reviews = read(KEYS.reviews);
    reviews.push({
        patient:currentUser.name,
        email:currentUser.email,
        hospitalId,
        hospitalName:hospital?.name || "",
        doctorId,
        doctorName:doctor?.name || "",
        rating:Number(document.getElementById("reviewRating").value),
        text,
        date:new Date().toLocaleString()
    });

    write(KEYS.reviews, reviews);
    document.getElementById("reviewText").value = "";
    renderReviews();
    alert("Review submitted.");
}

function renderReviews() {
