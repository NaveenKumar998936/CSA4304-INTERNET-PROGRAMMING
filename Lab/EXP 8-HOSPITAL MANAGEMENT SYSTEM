        <p class="muted">Demo admin: admin@medcare.com / admin123</p>
    </div>

    <div id="registerForm" class="hidden">
        <div class="grid">
            <div class="field"><label>Name / Hospital Name</label><input id="regName"></div>
            <div class="field"><label>Email</label><input id="regEmail" type="email"></div>
            <div class="field"><label>Password</label><input id="regPassword" type="password"></div>
            <div class="field"><label>Phone</label><input id="regPhone"></div>
