    <div class="actions">
        <button onclick="saveHospitalDetails()">Save Hospital Details</button>
    </div>

    <h3>Add Doctor</h3>
    <div class="grid">
        <div class="field"><label>Doctor Name</label><input id="newDoctorName"></div>
        <div class="field">
            <label>Specialty</label>
            <select id="newDoctorSpecialty">
                <option>General Physician</option><option>Cardiology</option>
                <option>Dermatology</option><option>Neurology</option>
                <option>Orthopedics</option><option>Pediatrics</option>
                <option>ENT</option><option>Gynecology</option>
            </select>
        </div>
        <div class="field"><label>Consultation Fee (₹)</label><input id="newDoctorFee" type="number" min="0" value="500"></div>
    </div>
    <div class="actions"><button onclick="addDoctor()">Add Doctor</button></div>

    <h3>My Hospital Appointments</h3>
    <div id="hospitalAppointments"></div>
</section>

<!-- ADMIN -->
<section id="adminPage" class="panel hidden">
    <h2>Administrator Dashboard</h2>
    <div id="adminStats" class="stats"></div>
    <h3>Manage All Appointments</h3>
    <div id="adminAppointments" class="tablewrap"></div>
    <h3>Registered Hospitals</h3>
    <div id="adminHospitals"></div>
    <h3>Rating Details</h3>
    <div id="adminReviews"></div>
</section>
</main>

<footer>MedCare Hospital Appointment System | Internet Programming Lab</footer>

<script>
// STORAGE HELPERS
const KEYS = {
    users:"medcare_users",
    hospitals:"medcare_hospitals",
    appointments:"medcare_appointments",
    reviews:"medcare_reviews"
};

function read(key) {
    return JSON.parse(localStorage.getItem(key) || "[]");
}
function write(key, data) {
    localStorage.setItem(key, JSON.stringify(data));
}
function safe(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
        "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
    }[c]));
}

const initialHospitals = [
    {
        id:"H1", name:"City Care Hospital", location:"Chennai",
        address:"Main Road, Chennai", phone:"9000000001",
        opening:"09:00", closing:"17:00",
        owner:"citycare@medcare.com",
        doctors:[
            {id:"D1",name:"Dr. Anitha",specialty:"General Physician",fee:500},
            {id:"D2",name:"Dr. Kumar",specialty:"Cardiology",fee:900}
        ]
    },
    {
        id:"H2", name:"Green Life Hospital", location:"Bengaluru",
        address:"Central Avenue, Bengaluru", phone:"9000000002",
        opening:"08:00", closing:"18:00",
        owner:"greenlife@medcare.com",
        doctors:[
            {id:"D3",name:"Dr. Ravi",specialty:"Orthopedics",fee:700},
            {id:"D4",name:"Dr. Priya",specialty:"Dermatology",fee:600}
        ]
    },
    {
        id:"H3", name:"Sunrise Medical Center", location:"Hyderabad",
        address:"Lake Road, Hyderabad", phone:"9000000003",
        opening:"09:00", closing:"17:00",
        owner:"sunrise@medcare.com",
        doctors:[
            {id:"D5",name:"Dr. Suresh",specialty:"Neurology",fee:1000},
            {id:"D6",name:"Dr. Meena",specialty:"Pediatrics",fee:550}
        ]
    },
    {
        id:"H4", name:"People's Health Hospital", location:"Chennai",
        address:"North Street, Chennai", phone:"9000000004",
        opening:"09:00", closing:"17:00",
        owner:"peoplehealth@medcare.com",
        doctors:[
            {id:"D7",name:"Dr. Farah",specialty:"Gynecology",fee:650},
            {id:"D8",name:"Dr. Naveen",specialty:"ENT",fee:500}
        ]
    }
];

if (!localStorage.getItem(KEYS.hospitals)) {
    write(KEYS.hospitals, initialHospitals);
}

if (!read(KEYS.users).some(u => u.email === "admin@medcare.com")) {
    write(KEYS.users, [
        ...read(KEYS.users),
        {
            name:"Administrator",
            email:"admin@medcare.com",
            password:"admin123",
            role:"admin",
            phone:"",
            location:""
        },
        {
            name:"City Care Hospital",
            email:"citycare@medcare.com",
            password:"hospital123",
            role:"hospital",
            phone:"9000000001",
            location:"Chennai"
        }
    ]);
}

let currentUser = null;
let chosenHospital = null;

// AUTHENTICATION
function updateAuthRole() {
    const role = document.getElementById("loginRole").value;
    document.getElementById("authTitle").textContent =
        role === "patient" ? "Patient Login" :
        role === "hospital" ? "Hospital Login" : "Administrator Login";
}

function toggleAuth(type) {
    ["loginForm","registerForm","forgotForm"].forEach(id =>
        document.getElementById(id).classList.add("hidden")
    );
    document.getElementById(type+"Form").classList.remove("hidden");
}

function register() {
    const role = document.getElementById("loginRole").value;
    if (role === "admin") {
        alert("Administrator registration is disabled.");
        return;
    }

    const name = document.getElementById("regName").value.trim();
    const email = document.getElementById("regEmail").value.trim().toLowerCase();
    const password = document.getElementById("regPassword").value;
    const phone = document.getElementById("regPhone").value.trim();
    const location = document.getElementById("regLocation").value.trim();

    if (!name || !email || password.length < 4) {
        alert("Enter name, email and a password of at least 4 characters.");
        return;
    }

    const users = read(KEYS.users);
    if (users.some(u => u.email === email)) {
        alert("This email is already registered.");
        return;
    }

    users.push({name,email,password,phone,location,role});
    write(KEYS.users, users);

    if (role === "hospital") {
        const hospitals = read(KEYS.hospitals);
        hospitals.push({
            id:"H"+Date.now(),
            name, location:location || "Not specified",
            address:location || "Not specified",
            phone, opening:"09:00", closing:"17:00",
            owner:email, doctors:[]
        });
        write(KEYS.hospitals, hospitals);
    }

    alert("Registration successful. Please log in.");
    document.getElementById("loginEmail").value = email;
    toggleAuth("login");
}

function login() {
    const email = document.getElementById("loginEmail").value.trim().toLowerCase();
    const password = document.getElementById("loginPassword").value;
    const role = document.getElementById("loginRole").value;

    const user = read(KEYS.users).find(
        u => u.email === email && u.password === password && u.role === role
    );

    if (!user) {
        alert("Invalid login details or account type.");
        return;
    }

    currentUser = user;
    document.getElementById("authPage").classList.add("hidden");
    document.getElementById("navigation").classList.remove("hidden");
    document.getElementById("adminNav").classList.toggle("hidden", role !== "admin");
    document.getElementById("hospitalNav").classList.toggle("hidden", role !== "hospital");

    const today = new Date().toISOString().slice(0,10);
    document.getElementById("searchDate").min = today;
    document.getElementById("searchDate").value = today;
    document.getElementById("appointmentDate").min = today;

    fillReviewOptions();
    showPage(role === "admin" ? "adminPage" :
             role === "hospital" ? "hospitalPage" : "searchPage");
}

function resetPassword() {
    const email = document.getElementById("forgotEmail").value.trim().toLowerCase();
    const password = document.getElementById("forgotPassword").value;
    const users = read(KEYS.users);
    const user = users.find(u => u.email === email && u.role !== "admin");

    if (!user || password.length < 4) {
        alert("Enter a registered account email and a password of at least 4 characters.");
        return;
    }

    user.password = password;
    write(KEYS.users, users);
    alert("Password reset for this demo. Please log in.");
    toggleAuth("login");
}

function logout() {
    currentUser = null;
    document.getElementById("navigation").classList.add("hidden");
    document.getElementById("authPage").classList.remove("hidden");
    ["searchPage","bookingPage","appointmentsPage","profilePage",
     "reviewPage","hospitalPage","adminPage"].forEach(id =>
        document.getElementById(id).classList.add("hidden")
    );
    toggleAuth("login");
}

// NAVIGATION
function showPage(id) {
    if (!currentUser) return;
    if (id === "adminPage" && currentUser.role !== "admin") return;
    if (id === "hospitalPage" && currentUser.role !== "hospital") return;

    ["searchPage","bookingPage","appointmentsPage","profilePage",
     "reviewPage","hospitalPage","adminPage"].forEach(page =>
        document.getElementById(page).classList.add("hidden")
    );
    document.getElementById(id).classList.remove("hidden");

    if (id === "appointmentsPage") renderAppointments();
    if (id === "profilePage") renderProfile();
    if (id === "reviewPage") renderReviews();
    if (id === "hospitalPage") renderHospitalPanel();
    if (id === "adminPage") renderAdmin();
}

// HOSPITAL SEARCH
function searchHospitals() {
    const location = document.getElementById("searchLocation").value.trim().toLowerCase();
    const specialty = document.getElementById("searchSpecialty").value;
    const date = document.getElementById("searchDate").value;

    if (!date || date < new Date().toISOString().slice(0,10)) {
        alert("Choose a valid appointment date.");
        return;
    }

    const hospitals = read(KEYS.hospitals).filter(h => {
        const locationMatch = !location ||
            h.location.toLowerCase().includes(location) ||
            h.address.toLowerCase().includes(location);
        const specialtyMatch = !specialty ||
            h.doctors.some(d => d.specialty === specialty);
        return locationMatch && specialtyMatch;
    });

    renderHospitalCards(hospitals, specialty, date);
}

function showAllHospitals() {
    renderHospitalCards(read(KEYS.hospitals), "", document.getElementById("searchDate").value);
}

function renderHospitalCards(hospitals, specialty, date) {
    const results = document.getElementById("hospitalResults");

    if (!hospitals.length) {
        results.innerHTML = "<p>No matching hospitals found. Try another location or specialty.</p>";
        return;
    }

    results.innerHTML = hospitals.map(h => {
        const doctors = h.doctors.filter(d => !specialty || d.specialty === specialty);
        const reviewData = read(KEYS.reviews).filter(r => r.hospitalId === h.id);
        const average = reviewData.length ?
            (reviewData.reduce((sum,r) => sum + Number(r.rating),0) / reviewData.length).toFixed(1) :
            "No ratings";

        return `
        <div class="card">
            <h3>${safe(h.name)}</h3>
            <p>📍 ${safe(h.location)} — ${safe(h.address)}</p>
            <p>☎ ${safe(h.phone)} | ⭐ ${average}</p>
            <h4>Available Doctors</h4>
            ${doctors.length ? doctors.map(d => `
                <p><b>${safe(d.name)}</b> — ${safe(d.specialty)}
                | Consultation: ₹${Number(d.fee)}</p>
            `).join("") : "<p>No doctors match this specialty.</p>"}
            <div class="actions">
                <button onclick="openBooking('${safe(h.id)}','${safe(date || "")}','${safe(specialty || "")}')">
                    Book Appointment
                </button>
                <button class="secondary" onclick="showMap('${safe(h.id)}')">
                    View Map
                </button>
            </div>
            <div id="map-${safe(h.id)}"></div>
        </div>`;
    }).join("");
}

function showMap(id) {
    const h = read(KEYS.hospitals).find(x => x.id === id);
    if (!h) return;
    const query = encodeURIComponent(h.address + " " + h.location);
    document.getElementById("map-" + id).innerHTML =
        `<iframe loading="lazy" title="Hospital map"
         src="https://maps.google.com/maps?q=${query}&output=embed"></iframe>
         <p><a target="_blank" rel="noopener"
         href="https://www.google.com/maps/search/?api=1&query=${query}">
         Open directions in Google Maps</a></p>`;
}

// APPOINTMENT BOOKING
function openBooking(hospitalId, date, specialty) {
    if (currentUser.role !== "patient") {
        alert("Please log in as a patient to book appointments.");
        return;
    }

    chosenHospital = read(KEYS.hospitals).find(h => h.id === hospitalId);
    if (!chosenHospital) return;

    document.getElementById("bookingHospitalInfo").innerHTML =
        `<h3>${safe(chosenHospital.name)}</h3>
         <p>${safe(chosenHospital.location)} | ${safe(chosenHospital.address)}</p>`;

    document.getElementById("appointmentDate").value =
        date || new Date().toISOString().slice(0,10);

    const doctors = chosenHospital.doctors.filter(
        d => !specialty || d.specialty === specialty
    );

    document.getElementById("doctorSelect").innerHTML = doctors.map(d =>
        `<option value="${safe(d.id)}">${safe(d.name)} — ${safe(d.specialty)} (₹${Number(d.fee)})</option>`
    ).join("");

    document.getElementById("patientName").value = currentUser.name;
    document.getElementById("patientPhone").value = currentUser.phone || "";

    updateSlots();
    showPage("bookingPage");
}

function updateDoctorDetails() {
    updateSlots();
}

function updateSlots() {
    if (!chosenHospital) return;

    const doctorId = document.getElementById("doctorSelect").value;
    const date = document.getElementById("appointmentDate").value;
    const doctor = chosenHospital.doctors.find(d => d.id === doctorId);
    if (!doctor) {
        document.getElementById("appointmentTime").innerHTML = "";
        return;
    }

    const times = [];
    for (let hour = 9; hour < 17; hour++) {
        for (const minute of [0,30]) {
            const h = String(hour).padStart(2,"0");
            const m = String(minute).padStart(2,"0");
            times.push(`${h}:${m}`);
        }
    }

    const appointments = read(KEYS.appointments);
    const available = times.filter(time =>
        !appointments.some(a =>
            a.hospitalId === chosenHospital.id &&
            a.doctorId === doctor.id &&
            a.date === date &&
            a.time === time &&
            a.status !== "Cancelled"
        )
    );

    document.getElementById("appointmentTime").innerHTML = available.length ?
        available.map(t => `<option value="${t}">${t}</option>`).join("") :
        `<option value="">No slots available</option>`;
}

function bookAppointment() {
    const doctorId = document.getElementById("doctorSelect").value;
    const date = document.getElementById("appointmentDate").value;
    const time = document.getElementById("appointmentTime").value;
    const name = document.getElementById("patientName").value.trim();
    const age = Number(document.getElementById("patientAge").value);
    const phone = document.getElementById("patientPhone").value.trim();
    const reason = document.getElementById("visitReason").value.trim();

    if (!date || date < new Date().toISOString().slice(0,10) ||
        !time || !name || age < 1 || age > 120 || !phone || !reason) {
        alert("Complete all fields and select a valid appointment slot.");
        return;
    }

    const doctor = chosenHospital.doctors.find(d => d.id === doctorId);
    const appointments = read(KEYS.appointments);

    const taken = appointments.some(a =>
        a.hospitalId === chosenHospital.id &&
        a.doctorId === doctorId &&
        a.date === date &&
        a.time === time &&
        a.status !== "Cancelled"
    );

    if (taken) {
        alert("This time slot has just been booked. Choose another.");
        updateSlots();
        return;
    }

    const appointment = {
        id:"MC" + Date.now().toString().slice(-8),
        patientEmail:currentUser.email,
        patientName:name,
        age, phone, reason,
        hospitalId:chosenHospital.id,
        hospitalName:chosenHospital.name,
        doctorId:doctor.id,
        doctorName:doctor.name,
        specialty:doctor.specialty,
        date, time,
        fee:doctor.fee,
        status:"Booked",
        checkin:false,
        created:new Date().toLocaleString()
    };

    appointments.push(appointment);
    write(KEYS.appointments, appointments);

    alert("Appointment booked successfully! Reference: " + appointment.id);
    showPage("appointmentsPage");
}

// PATIENT APPOINTMENTS AND CHECK-IN
function renderAppointments() {
    const list = read(KEYS.appointments).filter(
        a => a.patientEmail === currentUser.email
    ).reverse();

    document.getElementById("appointmentList").innerHTML = list.length ?
        list.map(a => `
            <div class="card">
                <h3>${safe(a.hospitalName)}</h3>
                <p><b>Doctor:</b> ${safe(a.doctorName)} (${safe(a.specialty)})</p>
                <p><b>Date:</b> ${safe(a.date)} | <b>Time:</b> ${safe(a.time)}</p>
                <p><b>Reference:</b> ${safe(a.id)} | <b>Fee:</b> ₹${Number(a.fee)}</p>
                <p class="badge ${a.status === "Cancelled" ? "cancelled" : ""}">
                    ${safe(a.status)}
                </p>
                ${a.checkin ? `<p>Check-in submitted: ${safe(a.checkinTime)}</p>` : ""}
                <div class="actions">
                    ${a.status !== "Cancelled" && !a.checkin ?
                        `<button class="success" onclick="checkIn('${safe(a.id)}')">Submit Check-in</button>` : ""}
                    ${a.status !== "Cancelled" && a.date >= new Date().toISOString().slice(0,10) ?
                        `<button class="danger" onclick="cancelAppointment('${safe(a.id)}')">Cancel</button>` : ""}
                </div>
            </div>
        `).join("") : "<p>No appointments yet.</p>";
}

function checkIn(id) {
    const appointments = read(KEYS.appointments);
    const a = appointments.find(x =>
        x.id === id && x.patientEmail === currentUser.email
    );
    if (!a) return;

    if (!confirm("Submit check-in for " + a.hospitalName + " at " + a.time + "?")) return;

    a.checkin = true;
    a.checkinTime = new Date().toLocaleString();
    write(KEYS.appointments, appointments);
    renderAppointments();
    alert("Check-in submitted successfully.");
}

function cancelAppointment(id) {
    if (!confirm("Cancel this appointment?")) return;

    const appointments = read(KEYS.appointments);
    const a = appointments.find(x =>
        x.id === id && x.patientEmail === currentUser.email
    );
    if (a) {
        a.status = "Cancelled";
        write(KEYS.appointments, appointments);
        renderAppointments();
    }
}

