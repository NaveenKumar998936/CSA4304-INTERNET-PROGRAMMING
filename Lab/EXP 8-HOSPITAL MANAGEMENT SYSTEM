document.getElementById("reviewHospital").addEventListener("change", updateReviewDoctors);

function updateReviewDoctors() {
    const id = document.getElementById("reviewHospital").value;
    const hospital = read(KEYS.hospitals).find(h => h.id === id);
    document.getElementById("reviewDoctor").innerHTML = hospital ?
        hospital.doctors.map(d => `<option value="${safe(d.id)}">${safe(d.name)} — ${safe(d.specialty)}</option>`).join("") :
