    <p class="muted">Create or update your hospital details and doctor schedules.</p>
    <div class="grid">
        <div class="field"><label>Hospital Name</label><input id="hName"></div>
        <div class="field"><label>Location</label><input id="hLocation"></div>
        <div class="field"><label>Address</label><input id="hAddress"></div>
        <div class="field"><label>Phone</label><input id="hPhone"></div>
        <div class="field"><label>Opening Time</label><input id="hOpening" value="09:00"></div>
        <div class="field"><label>Closing Time</label><input id="hClosing" value="17:00"></div>
