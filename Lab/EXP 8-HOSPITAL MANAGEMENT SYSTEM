<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MedCare Appointment System</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f2f7fb;color:#243447}
header{background:#075985;color:white;padding:16px 5%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
header h2{margin:0}
nav{display:flex;gap:7px;flex-wrap:wrap}
button{border:0;border-radius:7px;padding:10px 13px;background:#0284c7;color:white;cursor:pointer;font-weight:bold}
button:hover{opacity:.88}
.secondary{background:#e2e8f0;color:#1e293b}
.danger{background:#dc2626}
.success{background:#15803d}
main{max-width:1100px;margin:24px auto;padding:0 15px}
.hero{background:linear-gradient(120deg,#075985,#0ea5e9);color:white;padding:28px;border-radius:15px;margin-bottom:20px}
.hero h1{margin-top:0}
.panel{background:white;padding:20px;border-radius:12px;margin-bottom:18px;box-shadow:0 3px 15px #0000000b}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}
.field{display:flex;flex-direction:column;gap:6px}
label{font-size:14px;font-weight:bold}
input,select,textarea{padding:11px;border:1px solid #cbd5e1;border-radius:7px;font:inherit;width:100%}
textarea{min-height:90px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.hidden{display:none!important}
.card{border:1px solid #dbe5ee;border-radius:10px;padding:16px;margin:12px 0}
.card h3{margin-top:0}
.muted{color:#64748b;font-size:13px}
.badge{display:inline-block;padding:5px 9px;background:#dcfce7;color:#166534;border-radius:20px;font-size:12px;font-weight:bold}
.cancelled{background:#fee2e2;color:#991b1b}
.pending{background:#fef3c7;color:#92400e}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat{padding:17px;background:#eaf6ff;border-radius:10px}
.stat strong{display:block;font-size:25px;color:#0369a1;margin-top:6px}
table{border-collapse:collapse;width:100%;min-width:650px}
th,td{text-align:left;padding:10px;border-bottom:1px solid #e2e8f0;font-size:13px}
th{background:#eaf6ff}
.tablewrap{overflow-x:auto}
.note{padding:12px;background:#fff7d6;border-radius:8px;font-size:13px}
footer{text-align:center;color:#64748b;padding:20px}
iframe{width:100%;height:260px;border:0;border-radius:10px}
@media(max-width:650px){header{align-items:flex-start}.hero{padding:20px}.panel{padding:15px}}
</style>
</head>

<body>
<header>
    <h2>🏥 MedCare</h2>
    <nav id="navigation" class="hidden">
        <button onclick="showPage('searchPage')">Find Hospital</button>
        <button onclick="showPage('appointmentsPage')">My Appointments</button>
        <button onclick="showPage('profilePage')">My Profile</button>
        <button onclick="showPage('reviewPage')">Reviews</button>
        <button id="hospitalNav" class="hidden" onclick="showPage('hospitalPage')">Hospital Panel</button>
        <button id="adminNav" class="hidden" onclick="showPage('adminPage')">Admin</button>
        <button class="secondary" onclick="logout()">Logout</button>
