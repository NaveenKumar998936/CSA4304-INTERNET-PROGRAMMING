    <h2>Doctor Ratings and Reviews</h2>
    <div class="grid">
        <div class="field">
            <label>Hospital</label>
            <select id="reviewHospital"></select>
        </div>
        <div class="field">
            <label>Doctor</label>
            <select id="reviewDoctor"></select>
