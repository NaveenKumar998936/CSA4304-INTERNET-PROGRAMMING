<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f8;
            color: #333;
        }

        /* HEADER */
        header {
            background: #1e3a5f;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            margin-bottom: 10px;
        }

        nav {
            background: #14283f;
            padding: 12px;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 12px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd166;
        }

        /* COMMON */
        section {
            padding: 40px 7%;
        }

        .title {
            text-align: center;
            margin-bottom: 25px;
            color: #1e3a5f;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .btn {
            display: inline-block;
            background: #1e3a5f;
            color: white;
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
        }

        .btn:hover {
            background: #29527f;
        }

        /* HOME */
        .hero {
            min-height: 400px;
            background:
                linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.55)),
                url("https://images.unsplash.com/photo-1521587760476-6c12a4b040da")
                center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
        }

        .hero-content h2 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .hero-content p {
            font-size: 18px;
            margin-bottom: 20px;
        }

        /* SEARCH */
        .search-box {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ccc;
            margin-top: -30px;
            position: relative;
        }

        .search-box input {
            width: 70%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ddd;
        }

        .card h3 {
            color: #1e3a5f;
            margin-bottom: 10px;
        }

        .card p {
            margin: 8px 0;
        }

        /* BOOKS */
        .book-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .book {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ddd;
        }

        .book h3 {
            color: #1e3a5f;
            margin-bottom: 10px;
        }

        .available {
            color: green;
            font-weight: bold;
        }

        .unavailable {
            color: red;
            font-weight: bold;
        }

        /* FORMS */
        form {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ddd;
            max-width: 700px;
            margin: auto;
        }

        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 12px;
            margin-top: 6px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        textarea {
            height: 100px;
            resize: vertical;
        }

        form .btn {
            margin-top: 20px;
        }

        /* TABLE */
        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 3px 10px #ddd;
        }

        th,
        td {
            padding: 14px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #1e3a5f;
            color: white;
        }

        tr:nth-child(even) {
            background: #f5f5f5;
        }

        /* DASHBOARD */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .dashboard-card {
            background: white;
            padding: 25px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ddd;
        }

        .dashboard-card h2 {
            color: #1e3a5f;
            font-size: 30px;
        }

        .dashboard-card p {
            margin-top: 8px;
        }

        /* LOGIN */
        .login-box {
            max-width: 450px;
            margin: auto;
        }

        /* PROFILE */
        .profile {
            background: white;
            padding: 30px;
            border-radius: 10px;
            max-width: 700px;
            margin: auto;
            box-shadow: 0 3px 10px #ddd;
        }

        .profile p {
            margin: 15px 0;
        }

        /* FAQ */
        .faq {
            background: white;
            padding: 20px;
            margin: 12px auto;
            max-width: 800px;
            border-radius: 8px;
            box-shadow: 0 2px 8px #ddd;
        }

        .faq h3 {
            color: #1e3a5f;
            margin-bottom: 8px;
        }

        /* FOOTER */
        footer {
            background: #14283f;
            color: white;
            text-align: center;
            padding: 25px;
        }

        footer p {
            margin: 7px;
        }

        /* RESPONSIVE */
        @media (max-width: 800px) {

            .cards,
            .book-grid,
            .dashboard {
                grid-template-columns: 1fr;
            }

            nav a {
                display: inline-block;
                margin: 6px;
            }

            .hero-content h2 {
                font-size: 30px;
            }

            .search-box input {
                width: 100%;
                margin-bottom: 10px;
            }
        }
    </style>
</head>

