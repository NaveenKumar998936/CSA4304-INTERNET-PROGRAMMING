// BOOKING HISTORY AND CANCELLATION
function renderTickets() {
    const list = getBookings()
        .filter(b => b.user === currentUser.email)
        .reverse();

    document.getElementById("ticketList").innerHTML = list.length ?
        list.map(b => `
            <div class="panel">
                <h3>${safe(b.flightNo)}: ${safe(b.from)} → ${safe(b.to)}</h3>
                <p>Date: ${safe(b.date)} | Booking ID: ${safe(b.id)}</p>
                <p>Seats: ${b.seats.map(safe).join(", ")}</p>
                <p>Total: ₹${Number(b.total).toLocaleString("en-IN")}</p>
                <p class="${b.status === "Cancelled" ? "cancelled" : "status"}">
                    ${safe(b.status)}
                </p>
                <div class="actions">
                    <button onclick="viewTicket('${safe(b.id)}')">
                        View / Print Ticket
                    </button>
                    ${b.status === "Confirmed" &&
                      b.date >= new Date().toISOString().slice(0,10) ?
                        `<button class="danger"
                            onclick="cancelTicket('${safe(b.id)}')">
                            Cancel Ticket
                        </button>` : ""}
                </div>
            </div>
        `).join("") : "<p>No tickets found. Search for a flight to book.</p>";
}

function viewTicket(id) {
    const b = getBookings().find(
        x => x.id === id && x.user === currentUser.email
    );
    if (b) {
        renderTicket(b);
        showPage("ticketPage");
    }
}

function cancelTicket(id) {
    if (!confirm("Cancel this ticket? This demo does not process refunds.")) return;

    const bookings = getBookings();
    const booking = bookings.find(
        b => b.id === id && b.user === currentUser.email
    );

    if (booking) {
        booking.status = "Cancelled";
        saveData(BOOKINGS, bookings);
        renderTickets();
    }
}

// CUSTOMER FEEDBACK
function submitFeedback() {
    const message = document.getElementById("feedbackText").value.trim();

    if (!message) {
        alert("Please enter your feedback.");
        return;
    }

    const feedback = getData(FEEDBACK);
    feedback.push({
        name: currentUser.name,
        email: currentUser.email,
        rating: document.getElementById("rating").value,
        message,
        date: new Date().toLocaleString()
    });

    saveData(FEEDBACK, feedback);
    document.getElementById("feedbackText").value = "";
