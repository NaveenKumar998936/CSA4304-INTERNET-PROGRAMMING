function addFlight() {
    const no = document.getElementById("newFlightNo").value.trim();
    const from = document.getElementById("newFrom").value.trim();
    const to = document.getElementById("newTo").value.trim();
    const depart = document.getElementById("newDeparture").value.trim();
    const arrive = document.getElementById("newArrival").value.trim();
    const fare = Number(document.getElementById("newFare").value);
    const seats = Number(document.getElementById("newSeats").value);

    if (!no || !from || !to || from.toLowerCase() === to.toLowerCase() ||
        !depart || !arrive || fare <= 0 || seats < 1) {
        alert("Enter valid details for all flight fields.");
        return;
    }

    const flights = getData(FLIGHTS);

    if (flights.some(f => f.no.toLowerCase() === no.toLowerCase())) {
        alert("Flight number already exists.");
        return;
    }

    flights.push({
        id: "F" + Date.now(),
        no, from, to, depart, arrive, fare, seats
    });

    saveData(FLIGHTS, flights);
    alert("Sample flight added successfully.");
    renderAdmin();
}

function exportReport() {
    const bookings = getBookings();
    const rows = [
        ["Booking ID","Customer","Email","From","To","Date","Flight","Seats","Fare","Status"],
        ...bookings.map(b => [
            b.id, b.customerName, b.user, b.from, b.to, b.date,
            b.flightNo, b.seats.join(" "), b.total, b.status
        ])
    ];

    const csv = rows.map(row =>
        row.map(value => '"' + String(value).replace(/"/g,'""') + '"').join(",")
    ).join("\r\n");

    const url = URL.createObjectURL(
        new Blob([csv], {type:"text/csv;charset=utf-8;"})
    );
    const link = document.createElement("a");
    link.href = url;
    link.download = "flight_booking_report.csv";
    link.click();
    URL.revokeObjectURL(url);
}
