<script>
// DATA STORAGE
const USERS = "skybook_users";
const FLIGHTS = "skybook_flights";
const BOOKINGS = "skybook_bookings";
const FEEDBACK = "skybook_feedback";

function getData(key) {
    return JSON.parse(localStorage.getItem(key) || "[]");
}
function saveData(key, data) {
    localStorage.setItem(key, JSON.stringify(data));
}

const defaultFlights = [
    {id:"F101", no:"SB 101", from:"Hyderabad", to:"Delhi",
     depart:"06:30", arrive:"08:50", fare:4200, seats:24},
    {id:"F102", no:"SB 102", from:"Hyderabad", to:"Mumbai",
     depart:"09:15", arrive:"11:00", fare:3600, seats:24},
    {id:"F103", no:"SB 103", from:"Chennai", to:"Bengaluru",
     depart:"12:20", arrive:"13:20", fare:2200, seats:24},
    {id:"F104", no:"SB 104", from:"Bengaluru", to:"Delhi",
     depart:"15:10", arrive:"18:00", fare:5100, seats:24},
    {id:"F105", no:"SB 105", from:"Mumbai", to:"Kolkata",
     depart:"18:00", arrive:"20:45", fare:4700, seats:24},
    {id:"F106", no:"SB 106", from:"Delhi", to:"Chennai",
     depart:"20:10", arrive:"23:00", fare:4900, seats:24}
];

if (!localStorage.getItem(FLIGHTS)) {
    saveData(FLIGHTS, defaultFlights);
}

if (!getData(USERS).some(u => u.email === "admin@skybook.com")) {
    saveData(USERS, [
        ...getData(USERS),
        {
            name:"Administrator",
            email:"admin@skybook.com",
            password:"admin123",
            role:"admin"
        }
    ]);
}

let currentUser = null;
let selectedFlight = null;
let selectedSeats = [];

function safe(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
        "&":"&amp;", "<":"&lt;", ">":"&gt;",
        '"':"&quot;", "'":"&#39;"
    }[c]));
}

function toggleAuth(type) {
    ["loginForm","registerForm","forgotForm"].forEach(id =>
        document.getElementById(id).classList.add("hidden")
    );
    document.getElementById(type + "Form").classList.remove("hidden");

    document.getElementById("authHeading").textContent =
        type === "login" ? "Customer Login" :
        type === "register" ? "Create Account" : "Forgot Password";
}

function register() {
    const name = document.getElementById("regName").value.trim();
    const email = document.getElementById("regEmail").value.trim().toLowerCase();
    const password = document.getElementById("regPassword").value;

    if (!name || !email || password.length < 4) {
        alert("Enter your name, email and a password of at least 4 characters.");
        return;
    }

    const users = getData(USERS);

    if (users.some(u => u.email === email)) {
        alert("Email already registered.");
        return;
    }

    users.push({name, email, password, role:"customer"});
    saveData(USERS, users);

    alert("Registration successful. Please log in.");
    document.getElementById("loginEmail").value = email;
    toggleAuth("login");
}

function login() {
    const email = document.getElementById("loginEmail").value.trim().toLowerCase();
    const password = document.getElementById("loginPassword").value;

    const user = getData(USERS).find(
        u => u.email === email && u.password === password
    );

    if (!user) {
        alert("Invalid email or password.");
        return;
    }

    currentUser = user;
    document.getElementById("authPage").classList.add("hidden");
    document.getElementById("navigation").classList.remove("hidden");
    document.getElementById("adminButton").classList.toggle(
        "hidden", user.role !== "admin"
    );

    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    document.getElementById("travelDate").min =
        new Date().toISOString().slice(0,10);
    document.getElementById("travelDate").value =
        tomorrow.toISOString().slice(0,10);

    showPage("searchPage");
}

function resetPassword() {
    const email = document.getElementById("forgotEmail").value.trim().toLowerCase();
    const password = document.getElementById("forgotPassword").value;
    const users = getData(USERS);
    const user = users.find(u => u.email === email && u.role === "customer");

    if (!user || password.length < 4) {
        alert("Enter a registered customer email and a password of at least 4 characters.");
        return;
    }

    user.password = password;
    saveData(USERS, users);
    alert("Password reset. Please log in.");
    toggleAuth("login");
}

function logout() {
    currentUser = null;
    document.getElementById("navigation").classList.add("hidden");
    document.getElementById("authPage").classList.remove("hidden");

    ["searchPage","bookingPage","ticketsPage","ticketPage",
     "feedbackPage","adminPage"].forEach(id =>
        document.getElementById(id).classList.add("hidden")
    );
    toggleAuth("login");
}

function showPage(id) {
    if (!currentUser) return;
    if (id === "adminPage" && currentUser.role !== "admin") {
        alert("Admin access only.");
        return;
    }

    ["searchPage","bookingPage","ticketsPage","ticketPage",
     "feedbackPage","adminPage"].forEach(page =>
        document.getElementById(page).classList.add("hidden")
    );

    document.getElementById(id).classList.remove("hidden");

    if (id === "ticketsPage") renderTickets();
    if (id === "adminPage") renderAdmin();
}

// FLIGHT SEARCH
function getBookings() {
    return getData(BOOKINGS);
}

function getBookedSeats(flightId, date) {
    return getBookings()
        .filter(b => b.flightId === flightId &&
                     b.date === date && b.status === "Confirmed")
        .flatMap(b => b.seats);
}

function searchFlights() {
    const from = document.getElementById("from").value;
    const to = document.getElementById("to").value;
    const date = document.getElementById("travelDate").value;
    const travelClass = document.getElementById("travelClass").value;

    if (from === to) {
        alert("Origin and destination must be different.");
        return;
    }
    if (!date || date < new Date().toISOString().slice(0,10)) {
        alert("Choose a valid travel date.");
        return;
    }

    const flights = getData(FLIGHTS).filter(f =>
        f.from.toLowerCase() === from.toLowerCase() &&
        f.to.toLowerCase() === to.toLowerCase()
    );

    const results = document.getElementById("flightResults");

    if (!flights.length) {
        results.innerHTML = "<p>No sample flights found. Try Hyderabad to Delhi or another listed route.</p>";
        return;
    }

    results.innerHTML = flights.map(f => {
        const available = f.seats - getBookedSeats(f.id, date).length;
        const fare = Math.round(
            f.fare * (travelClass === "Business" ? 2.1 :
                      travelClass === "First" ? 3.2 : 1)
        );

        return `
        <div class="flight">
            <div>
                <b>${safe(f.no)}</b>
                <p>${safe(f.from)} → ${safe(f.to)}</p>
                <small>${safe(f.depart)} - ${safe(f.arrive)}</small>
            </div>
            <div>
                <p>${safe(date)}</p>
                <small>${available} seats available</small>
            </div>
            <div>
                <div class="price">₹${fare.toLocaleString("en-IN")}</div>
                <small>${safe(travelClass)}</small>
            </div>
            <button ${available <= 0 ? "disabled" : ""}
                onclick="startBooking('${safe(f.id)}',${fare},'${safe(travelClass)}','${safe(date)}')">
                Select
            </button>
        </div>`;
    }).join("");
}

// SEAT SELECTION AND BOOKING
function startBooking(id, fare, travelClass, date) {
    const flight = getData(FLIGHTS).find(f => f.id === id);
    selectedFlight = {...flight, fare, travelClass, date};
    selectedSeats = [];

    const count = Number(document.getElementById("passengers").value);

    document.getElementById("passengerFields").innerHTML =
        Array.from({length:count}, (_,i) => `
            <div class="field">
                <label>Passenger ${i+1} Name</label>
                <input id="pname${i}" placeholder="Full name">
            </div>
            <div class="field">
                <label>Passenger ${i+1} Age</label>
                <input id="page${i}" type="number" min="1" max="120">
            </div>
        `).join("");

    document.getElementById("paymentReference").value = "";
    document.getElementById("bookingError").textContent = "";
    renderSeats();
    showPage("bookingPage");
}

function renderSeats() {
    const f = selectedFlight;
    const booked = getBookedSeats(f.id, f.date);
    const count = Number(document.getElementById("passengers").value);

    document.getElementById("selectedFlightInfo").innerHTML = `
        <h3>${safe(f.no)}: ${safe(f.from)} → ${safe(f.to)}</h3>
        <p>Date: ${safe(f.date)} | Class: ${safe(f.travelClass)}</p>
        <p>Fare per passenger: ₹${f.fare.toLocaleString("en-IN")}</p>
        <p>Total: ₹${(f.fare * count).toLocaleString("en-IN")}</p>
    `;

    document.getElementById("seatGrid").innerHTML =
        Array.from({length:f.seats}, (_,i) => {
            const seat = String.fromCharCode(65 + Math.floor(i/6)) + (i%6+1);
            const taken = booked.includes(seat);
            const selected = selectedSeats.includes(seat);

            return `<button class="seat ${taken ? "taken" : ""} ${selected ? "selected" : ""}"
                ${taken ? "disabled" : ""}
                onclick="toggleSeat('${seat}')">${seat}</button>`;
        }).join("");

    document.getElementById("seatInfo").textContent =
        "Selected seats: " + (selectedSeats.join(", ") || "None") +
        ` (${selectedSeats.length}/${count})`;
}

function toggleSeat(seat) {
    const count = Number(document.getElementById("passengers").value);

    if (selectedSeats.includes(seat)) {
        selectedSeats = selectedSeats.filter(s => s !== seat);
    } else if (selectedSeats.length < count) {
        selectedSeats.push(seat);
    } else {
        alert("You have selected enough seats.");
        return;
    }
    renderSeats();
}

function confirmBooking() {
    const count = Number(document.getElementById("passengers").value);
    const passengers = [];

    for (let i = 0; i < count; i++) {
        const name = document.getElementById("pname" + i).value.trim();
        const age = Number(document.getElementById("page" + i).value);

        if (!name || age < 1 || age > 120) {
            document.getElementById("bookingError").textContent =
                "Enter a valid name and age for every passenger.";
            return;
        }
        passengers.push({name, age});
    }

    if (selectedSeats.length !== count) {
        document.getElementById("bookingError").textContent =
            `Please select exactly ${count} seat(s).`;
        return;
    }

    if (!document.getElementById("paymentReference").value.trim()) {
        document.getElementById("bookingError").textContent =
            "Enter a demo payment reference.";
        return;
    }

    const bookings = getBookings();
    const taken = getBookedSeats(selectedFlight.id, selectedFlight.date);

    if (selectedSeats.some(s => taken.includes(s))) {
        alert("A selected seat is no longer available. Choose another seat.");
        renderSeats();
        return;
    }

    const booking = {
        id: "SB" + Date.now().toString().slice(-8),
        user: currentUser.email,
        customerName: currentUser.name,
        flightId: selectedFlight.id,
        flightNo: selectedFlight.no,
        from: selectedFlight.from,
        to: selectedFlight.to,
        date: selectedFlight.date,
        depart: selectedFlight.depart,
        arrive: selectedFlight.arrive,
        travelClass: selectedFlight.travelClass,
        seats: [...selectedSeats],
        passengers,
        total: selectedFlight.fare * count,
        paymentMethod: document.getElementById("paymentMethod").value,
        status: "Confirmed",
        created: new Date().toLocaleString()
    };

    bookings.push(booking);
    saveData(BOOKINGS, bookings);
    renderTicket(booking);
    showPage("ticketPage");
}

