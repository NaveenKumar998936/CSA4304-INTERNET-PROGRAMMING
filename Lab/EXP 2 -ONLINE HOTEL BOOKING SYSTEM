<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Grand Stay - Hotel Booking System</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f8;
            color: #333;
        }

        /* ---------- HEADER ---------- */

        header {
            background: #243447;
            color: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 28px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-size: 15px;
        }

        nav a:hover {
            color: #f1c40f;
        }

        /* ---------- HERO ---------- */

        .hero {
            background: linear-gradient(
                rgba(0,0,0,0.5),
                rgba(0,0,0,0.5)
            ),
            url("https://images.unsplash.com/photo-1566073771259-6a8506099945")
            center/cover;

            min-height: 450px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
        }

        .hero-content h2 {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .hero-content p {
            font-size: 18px;
            margin-bottom: 30px;
        }

        /* ---------- SEARCH ---------- */

        .search-box {
            background: white;
            padding: 25px;
            border-radius: 10px;
            width: 90%;
            max-width: 1000px;
            margin: auto;
            color: #333;
        }

        .search-box h3 {
            margin-bottom: 15px;
            color: #243447;
        }

        .search-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        input,
        select,
        textarea {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 100%;
        }

        .search-row input,
        .search-row select {
            flex: 1;
            min-width: 180px;
        }

        button {
            background: #3498db;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #2980b9;
        }

        /* ---------- COMMON ---------- */

        .section {
            padding: 50px 8%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 30px;
            color: #243447;
        }

        /* ---------- ROOMS ---------- */

        .rooms {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .room-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 10px rgba(0,0,0,0.12);
        }

        .room-image {
            height: 180px;
            background-size: cover;
            background-position: center;
        }

        .single {
            background-image: url("https://images.unsplash.com/photo-1505693416388-ac5ce068fe85");
        }

        .double {
            background-image: url("https://images.unsplash.com/photo-1611892440504-42a792e24d32");
        }

        .deluxe {
            background-image: url("https://images.unsplash.com/photo-1582719478250-c89cae4dc85b");
        }

        .suite {
            background-image: url("https://images.unsplash.com/photo-1590490360182-c33d57733427");
        }

        .room-info {
            padding: 20px;
        }

        .room-info h3 {
            color: #243447;
            margin-bottom: 10px;
        }

        .price {
            color: #e67e22;
            font-size: 20px;
            font-weight: bold;
            margin: 10px 0;
        }

        .amenities {
            color: #666;
            line-height: 1.8;
            margin-bottom: 15px;
        }

        /* ---------- BOOKING ---------- */

        .booking-container {
            background: white;
            max-width: 800px;
            margin: auto;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .form-row {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

        .form-group {
            flex: 1;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
        }

        /* ---------- BOOKING HISTORY ---------- */

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th,
        td {
            padding: 14px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #243447;
            color: white;
        }

        .confirmed {
            color: green;
            font-weight: bold;
        }

        .cancelled {
            color: red;
            font-weight: bold;
        }

        /* ---------- LOGIN ---------- */

        .login-box {
            max-width: 450px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .login-box h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #243447;
        }

        .login-box label {
            display: block;
            margin: 10px 0 5px;
            font-weight: bold;
        }

        .login-box button {
            width: 100%;
            margin-top: 15px;
        }

        /* ---------- ADMIN ---------- */

        .admin-dashboard {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .admin-card {
            background: white;
            padding: 25px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .admin-card h3 {
            font-size: 30px;
            color: #3498db;
        }

        /* ---------- PROFILE ---------- */

        .profile {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        /* ---------- FAQ ---------- */

        .faq {
            background: white;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        .faq h3 {
            color: #243447;
            margin-bottom: 8px;
        }

        /* ---------- CONTACT ---------- */

        .contact {
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        .contact input,
        .contact textarea {
            margin-bottom: 15px;
        }

        .contact textarea {
            height: 120px;
        }

        /* ---------- FOOTER ---------- */

        footer {
            background: #243447;
            color: white;
            padding: 40px 8%;
            margin-top: 30px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        footer h3 {
            margin-bottom: 15px;
        }

        footer p,
        footer a {
            color: #ddd;
            line-height: 1.8;
            text-decoration: none;
        }

        .copyright {
            text-align: center;
            border-top: 1px solid #555;
            margin-top: 30px;
            padding-top: 20px;
        }

        /* ---------- RESPONSIVE ---------- */

        @media(max-width: 900px) {

            .rooms {
                grid-template-columns: repeat(2, 1fr);
            }

            .admin-dashboard {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-content {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media(max-width: 600px) {

            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 5px;
            }

            .hero-content h2 {
                font-size: 30px;
            }

            .rooms {
                grid-template-columns: 1fr;
            }

            .admin-dashboard {
                grid-template-columns: 1fr;
            }

            .footer-content {
                grid-template-columns: 1fr;
            }

            .form-row {
                flex-direction: column;
            }

        }

    </style>

</head>

